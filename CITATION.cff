    given-names: "Thibault"
    affiliation: "Université libre de Bruxelles (ULB) — CRSE — Shift Research Unit"
version: "1.0.0"
date-released: "2026-04-28"
license: GPL-3.0-or-later
doi: "10.5281/zenodo.19852967"
repository-code: "https://github.com/thibaultcoppe-ULB/SLRcraft"
keywords:
  - systematic literature review
  - systematic review
  - screening
  - PRISMA
  - education research
  - research methodology
